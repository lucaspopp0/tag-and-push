{
  "name": "tag-and-push",
  "version": "1.0.0",
  "description": "GitHub Action to create and push git tags via the GraphQL API",
  "homepage": "https://github.com/lucaspopp0/tag-and-push#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaspopp0/tag-and-push.git"
  },
  "license": "MIT",
  "author": "Lucas Popp",
  "scripts": {
    "build": "tsc --noEmit",
    "pack": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run build && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/graphql": "^9.0.3",
    "@octokit/request-error": "^7.1.0"
  }
}
